# Local development defaults (copy to .env)
POSTGRES_USER=anylive
POSTGRES_PASSWORD=anylive
POSTGRES_DB=anylive
DATABASE_URL=postgres://anylive:anylive@localhost:5432/anylive
# Opt-in Postgres user store + migrations (default: in-memory for offline tests).
USE_POSTGRES=0
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
CENTRIFUGO_URL=http://localhost:8001
CENTRIFUGO_API_KEY=anylive-dev-api-key
CENTRIFUGO_TOKEN_SECRET=anylive-dev-token-secret-change-me
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
SRS_API_URL=http://localhost:1985
SRS_RTMP_URL=rtmp://localhost:1935/live
SRS_HLS_BASE=http://localhost:8080/live
# Broadcast MediaProvider: srs (default) | cloudflare (URL scaffold only)
# MEDIA_PROVIDER=cloudflare
# CF_STREAM_RTMPS_URL=rtmps://live.cloudflare.com:443/live
# CF_STREAM_PLAYBACK_BASE=https://customer-XXXX.cloudflarestream.com
# CF_STREAM_INPUT_UID=your-live-input-uid
# CF_STREAM_PUBLISH_SECRET=optional-hmac-secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anylive
# MINIO_ENABLED=1 → avatar presign returns MinIO path-style PUT URLs.
# When unset/0 (default), API serves synthetic PUT /api/v1/me/avatar/blob.
MINIO_ENABLED=0
# Optional public base for avatar URLs (default: {MINIO_ENDPOINT}/{MINIO_BUCKET}).
# MINIO_PUBLIC_BASE=http://localhost:9000/anylive
RUST_LOG=info,anylive_api=debug
# Log format: text (default) or json/structured for collectors (WBS E0.5).
# See docs/runbooks/otel.md — full OTLP export is ops-side.
# RUST_LOG_FORMAT=json
API_BIND=0.0.0.0:8088

# Production only: comma-separated absolute origins (required when APP_ENV=production)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Shared secret for SRS HTTP hooks (X-AnyLive-Webhook-Secret or ?secret=). Empty = open (local only).
# SRS_WEBHOOK_SECRET=

# Pay channels (comma-separated). Mock sandbox: mock or PAY_ENABLE_MOCK=1.
# P2 overseas: add stripe,iap (sandbox adapters; real Stripe/IAP certs later).
# PAY_CHANNELS=mock
# PAY_CHANNELS=mock,stripe,iap
# PAY_CHANNELS=mock,jeepay,epay,tokenpay
# PAY_ENABLE_MOCK=1
# PAY_MOCK_SECRET=change-me-for-shared-dogfood  # required non-default outside local/dev/test
# PAY_STRIPE_SECRET=whsec_test_or_hmac_secret
# PAY_STRIPE_CHECKOUT_BASE=https://checkout.stripe.com/c/pay
# PAY_IAP_SECRET=iap-sandbox-hmac-secret
# PAY_JEEPAY_SECRET=jeepay-sandbox-hmac
# PAY_EPAY_SECRET=epay-sandbox-hmac
# PAY_TOKENPAY_SECRET=tokenpay-sandbox-hmac
# Public base used to build notify_url for providers
# PAY_PUBLIC_BASE_URL=http://localhost:8088

# OTP delivery:
#   local: log | noop | ALLOW_DEV_OTP fixed code
#   production: smtp | http | webhook AND OTP_HTTP_URL (or OTP_SMTP_WEBHOOK_URL)
# OTP_NOTIFIER=http
# OTP_HTTP_URL=https://mailer.example/v1/send
# OTP_HTTP_BEARER=
# OTP_HTTP_FROM=noreply@example.com
# OTP_HTTP_SUBJECT=Your AnyLive login code

# OAuth exchange scaffold (WBS E2.1). Stub tokens: id_token = "stub:<email>".
# Production forbids OAUTH_STUB. Real Google/Apple JWKS still needs vendor keys.
# OAUTH_STUB=1
# OAUTH_PROVIDERS=google,apple

# Push delivery (WBS E8.9). Default noop — no vendor call.
# PUSH_DELIVERY=noop|log|http
# PUSH_HTTP_URL=https://push-bridge.example/v1/send
# PUSH_HTTP_BEARER=

# Soft-launch invite gate (P2 M2.4). When INVITE_ONLY=1, OTP verify requires
# email on allowlist or a valid invite_code in the verify body.
# INVITE_ONLY=0
# INVITE_EMAIL_ALLOWLIST=host@example.com,fan@example.com
# INVITE_CODES=VIP-1,soft-launch

# Chat content safety v1 (P2): comma-separated case-insensitive substrings.
# Empty = open (no filter). Example: CHAT_BLOCKLIST=spam,scam,phishing
# CHAT_BLOCKLIST=

# LiveKit interactive plane (P3 co-host / PK). All three required to enable
# POST /api/v1/rooms/{id}/livekit/join. When unset, join returns MEDIA_PROVIDER_ERROR.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Feature flags / GA kill-switches.
# PUBLIC_REGISTER / REAL_PAY / CLIENT_EVENTS: default ON when unset.
# PK / COHOST (P3): default OFF when unset — set =1 only after P1 exit (plan 06).
# FEATURE_PUBLIC_REGISTER=1
# FEATURE_REAL_PAY=1
# FEATURE_PK=0
# FEATURE_COHOST=0
# FEATURE_CLIENT_EVENTS=1
