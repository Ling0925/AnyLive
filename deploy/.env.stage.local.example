# Local stage-topology rehearsal (P2 M2.1) — copy to deploy/.env.stage.local (gitignored).
# Not for public internet. Real stage hosts use deploy/.env.stage.example + secrets store.
#
#   cp deploy/.env.stage.local.example deploy/.env.stage.local
#   # replace CHANGE_ME_* with long randoms (./scripts/stage-up.sh can mint)
#   ./scripts/stage-up.sh
#
# Honest labels:
# - APP_ENV=staging → production fail-closed secrets apply only for production|prod
# - Prefer OTP_NOTIFIER=http + OTP_HTTP_URL; if you enable ALLOW_DEV_OTP=1 for
#   local rehearsal, you are NOT claiming ESP delivery.

# --- Core ---
APP_ENV=staging
API_BIND=0.0.0.0:8088
USE_POSTGRES=1
DATABASE_URL=postgres://anylive:anylive@postgres:5432/anylive
POSTGRES_USER=anylive
POSTGRES_PASSWORD=anylive
POSTGRES_DB=anylive

# Mint ≥32-char secrets (stage-up.sh fills if left as CHANGE_ME_*)
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars____
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars___
CENTRIFUGO_URL=http://centrifugo:8000
CENTRIFUGO_API_KEY=CHANGE_ME_centrifugo_api_key
CENTRIFUGO_TOKEN_SECRET=CHANGE_ME_centrifugo_token_secret

# Browser origins for local H5 + admin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8090,http://127.0.0.1:8090
VITE_API_BASE=http://localhost:8088

# --- OTP ---
# Default: no fixed OTP. For pure local topology without ESP, set:
#   ALLOW_DEV_OTP=1
#   OTP_NOTIFIER=log
# and document in your own notes that this is rehearsal-only.
ALLOW_DEV_OTP=0
OTP_NOTIFIER=http
OTP_HTTP_URL=
OTP_HTTP_BEARER=
OTP_HTTP_FROM=noreply@stage.local
OTP_HTTP_SUBJECT=Your AnyLive login code

# --- Pay: no mock ---
ALLOW_MOCK_TOPUP=0
PAY_ENABLE_MOCK=0
PAY_CHANNELS=
PAY_PUBLIC_BASE_URL=http://localhost:8088

# --- Media (local SRS ports from base compose) ---
SRS_RTMP_URL=rtmp://localhost:1935/live
SRS_HLS_BASE=http://localhost:8080/live
SRS_API_URL=http://srs:1985
SRS_PUBLISH_SECRET=CHANGE_ME_long_random_publish_secret
SRS_WEBHOOK_SECRET=CHANGE_ME_long_random_webhook_secret

# --- Soft-launch knobs ---
INVITE_ONLY=0
FEATURE_PUBLIC_REGISTER=1
FEATURE_REAL_PAY=1
FEATURE_PK=0
FEATURE_COHOST=0
FEATURE_CLIENT_EVENTS=1

RUST_LOG=info,anylive_api=info
RUST_LOG_FORMAT=json
