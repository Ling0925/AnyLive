# Test stack defaults for `docker compose -f deploy/docker-compose.yml --profile app up`
# Loaded automatically when compose is run from deploy/ (or pass --env-file deploy/.env.test).

POSTGRES_USER=anylive
POSTGRES_PASSWORD=anylive
POSTGRES_DB=anylive

# Secrets (dev/test only — never use in real production)
JWT_ACCESS_SECRET=test-access-secret-change-me-32ch
JWT_REFRESH_SECRET=test-refresh-secret-change-me-32ch
CENTRIFUGO_TOKEN_SECRET=anylive-dev-token-secret-change-me
CENTRIFUGO_API_KEY=anylive-dev-api-key

# Browser-facing origins (admin container + local vite)
VITE_API_BASE=http://localhost:8088

# Dogfood / sandbox feature flags (never enable in real production)
APP_ENV=local
ALLOW_MOCK_TOPUP=1
ALLOW_DEV_OTP=1
OTP_NOTIFIER=noop
SRS_PUBLISH_SECRET=test-srs-publish-secret-change-me
SRS_WEBHOOK_SECRET=test-srs-webhook-secret
