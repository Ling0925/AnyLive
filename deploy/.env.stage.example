# Stage (pre-prod) fillable template — copy to a secrets store or deploy/.env.stage
# (never commit real secrets). Cross-links: docs/runbooks/go-live-stage.md · .env.example
#
# Usage (example):
#   cp deploy/.env.stage.example deploy/.env.stage
#   # fill secrets, then inject into runtime / compose override
#
# P1-safe: FEATURE_PK=0 FEATURE_COHOST=0 — never enable as stage defaults.
# Production-like guards: mock topup / dev OTP / pay mock OFF.

# --- Core ---
APP_ENV=staging
API_BIND=0.0.0.0:8088
USE_POSTGRES=1
DATABASE_URL=postgres://anylive:CHANGE_ME@postgres:5432/anylive

# JWT / Centrifugo (non-default, ≥32 for JWT)
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
CENTRIFUGO_URL=http://centrifugo:8000
CENTRIFUGO_API_KEY=CHANGE_ME_centrifugo_api_key
CENTRIFUGO_TOKEN_SECRET=CHANGE_ME_centrifugo_token_secret

# Browser origins (comma-separated absolute origins)
CORS_ALLOWED_ORIGINS=https://app.stage.example.com,https://admin.stage.example.com,https://h5.stage.example.com

# --- OTP: real delivery (dev fixed OTP OFF) ---
ALLOW_DEV_OTP=0
OTP_NOTIFIER=http
OTP_HTTP_URL=https://mailer.stage.example/v1/send
OTP_HTTP_BEARER=
OTP_HTTP_FROM=noreply@stage.example.com
OTP_HTTP_SUBJECT=Your AnyLive login code

# --- Wallet / pay: no mock on stage defaults ---
ALLOW_MOCK_TOPUP=0
# Do not set PAY_CHANNELS=mock or PAY_ENABLE_MOCK=1 for stage defaults.
# When real sandbox channels exist, configure them explicitly:
# PAY_CHANNELS=stripe,iap
# PAY_STRIPE_SECRET=
# PAY_PUBLIC_BASE_URL=https://api.stage.example.com

# --- Media (SRS) ---
SRS_RTMP_URL=rtmp://media.stage.example.com/live
SRS_HLS_BASE=https://cdn.stage.example.com/live
SRS_API_URL=http://srs:1985
SRS_PUBLISH_SECRET=CHANGE_ME_long_random_publish_secret
SRS_WEBHOOK_SECRET=CHANGE_ME_long_random_webhook_secret

# --- Feature flags (P1-safe / plan 06) ---
# PK / cohost are P3 experimental — keep OFF until after P1 exit sign-off.
FEATURE_PUBLIC_REGISTER=1
FEATURE_REAL_PAY=1
FEATURE_PK=0
FEATURE_COHOST=0
FEATURE_CLIENT_EVENTS=1

# --- Optional ---
# REDIS_URL=redis://redis:6379
# NATS_URL=nats://nats:4222
# LEGAL_PRIVACY_URL=https://stage.example.com/privacy
# LEGAL_TERMS_URL=https://stage.example.com/terms
# INVITE_ONLY=0

# Stage re-smoke (control-plane; real OTP — not dev 123456):
#   DOGFOOD_STRICT=1 OTP_CODE=<real> API_BASE=https://api.stage.example.com \
#     ./scripts/dogfood-api-smoke.sh
#
# Unsigned risk-accept drafts (do not auto-flip V-BE):
#   docs/runbooks/otp-dev-only-risk-accept.md  (V-BE-1)
#   docs/runbooks/ws-1k-soak-risk-accept.md    (V-BE-2)
