{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anylive.dev/schemas/events/gift.sent.v1.json",
  "title": "anylive.gift.sent.v1",
  "description": "NATS subject gift.sent payload (WBS E1.3 / E5.3). Published fire-and-forget after successful gift debit.",
  "type": "object",
  "required": ["schema", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "anylive.gift.sent.v1"
    },
    "type": {
      "const": "gift.sent"
    },
    "payload": {
      "type": "object",
      "required": [
        "order_id",
        "room_id",
        "sender_id",
        "receiver_id",
        "gift_id",
        "count",
        "total_coins"
      ],
      "additionalProperties": false,
      "properties": {
        "order_id": { "type": "string", "format": "uuid" },
        "room_id": { "type": "string", "format": "uuid" },
        "sender_id": { "type": "string", "format": "uuid" },
        "receiver_id": { "type": "string", "format": "uuid" },
        "gift_id": { "type": "string", "format": "uuid" },
        "count": { "type": "integer", "minimum": 1 },
        "total_coins": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "examples": [
    {
      "schema": "anylive.gift.sent.v1",
      "type": "gift.sent",
      "payload": {
        "order_id": "11111111-1111-1111-1111-111111111111",
        "room_id": "22222222-2222-2222-2222-222222222222",
        "sender_id": "33333333-3333-3333-3333-333333333333",
        "receiver_id": "44444444-4444-4444-4444-444444444444",
        "gift_id": "55555555-5555-5555-5555-555555555555",
        "count": 1,
        "total_coins": 10
      }
    }
  ]
}
